# Provide your time zone in tz database name, e.g. TZ=America/Los_Angeles
TZ=Europe/Moscow

# Provide zigbee channel (11-26). 11, 15, 20, 25 are typically least congested.
ZIGBEE_CHANNEL=11

# Zigbee adapter type used by zigbee2mqtt. Common values:
#   ember     — Silicon Labs EmberZNet (e.g. Sonoff ZBDongle-E, Home Assistant SkyConnect/Connect ZBT-1)
#   zstack    — Texas Instruments CC253x/CC26x2/CC1352 (e.g. Sonoff ZBDongle-P, CC2652)
#   deconz    — ConBee/RaspBee
#   ezsp      — legacy EmberZNet (deprecated, use 'ember')
#   zboss     — Nordic nRF52 with ZBOSS firmware
#   zigate    — ZiGate
ZIGBEE_ADAPTER=ember

# Optional: enable services beyond the base HA + Mosquitto stack.
# Comma-separated profiles. Available: z2m, matter, matter-hub, music
# z2m is also auto-enabled if a zigbee coordinator is detected by setup.sh.
# matter-hub triggers headless HA onboarding (creates HA_ADMIN_USERNAME with a
# generated password); enable only if you actually want the bridge.
# Examples:
#   COMPOSE_PROFILES=matter,music
#   COMPOSE_PROFILES=matter-hub
#   COMPOSE_PROFILES=
COMPOSE_PROFILES=z2m,matter,music

# --- matter-hub (home-assistant-matter-hub) tunables ---
# Used only when 'matter-hub' is in COMPOSE_PROFILES.
HAMH_HOME_ASSISTANT_URL=http://localhost:8123/
HAMH_HTTP_PORT=8482
HAMH_LOG_LEVEL=info

# --- HA bootstrap user (created headlessly by setup.sh when matter-hub is enabled) ---
HA_ADMIN_USERNAME=admin
HA_ADMIN_LANGUAGE=ru

# --- Auto-populated by scripts/setup.sh on first run. Do not edit by hand. ---
MOSQUITTO_PASSWORD=
Z2MPATH=
HA_ADMIN_PASSWORD=
HAMH_HOME_ASSISTANT_ACCESS_TOKEN=