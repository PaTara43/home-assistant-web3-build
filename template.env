# Provide your time zone in tz database name, e.g. TZ=America/Los_Angeles
TZ=Europe/Moscow

# Provide zigbee channel (11-26). 11, 15, 20, 25 are typically least congested.
ZIGBEE_CHANNEL=11

# Zigbee adapter type used by zigbee2mqtt. Common values:
#   ember     — Silicon Labs EmberZNet (e.g. Sonoff ZBDongle-E, Home Assistant SkyConnect/Connect ZBT-1)
#   zstack    — Texas Instruments CC253x/CC26x2/CC1352 (e.g. Sonoff ZBDongle-P, CC2652)
#   deconz    — ConBee/RaspBee
#   ezsp      — legacy EmberZNet (deprecated, use 'ember')
#   zboss     — Nordic nRF52 with ZBOSS firmware
#   zigate    — ZiGate
ZIGBEE_ADAPTER=ember

# Zigbee coordinator transport: usb (default, auto-detected) or tcp (PoE adapters,
# e.g. SMLight SLZB-06). For tcp, set Z2M_TCP_HOST below; Z2M_TCP_PORT defaults to
# 6638 (SLZB-06). ZIGBEE_ADAPTER must match the chip: SLZB-06 -> zstack.
Z2M_TRANSPORT=usb
Z2M_TCP_HOST=
Z2M_TCP_PORT=6638

# Optional: serial baudrate. Required for TCP/PoE adapters (SLZB-06 -> 115200).
# Leave empty for USB (z2m uses its own default).
Z2M_BAUDRATE=

# Zigbee2MQTT frontend port and MQTT base topic (instance 1).
# Change if running a second instance (z2m2) to avoid port/topic collisions.
Z2M_FRONTEND_PORT=8099
Z2M_BASE_TOPIC=zigbee2mqtt

# --- Second Zigbee2MQTT instance (optional, e.g. for a second coordinator) ---
# Enable by adding 'z2m2' to COMPOSE_PROFILES. Must use a different channel,
# frontend port, and base topic than instance 1. usb+usb is NOT supported —
# use usb+tcp or tcp+tcp. Reuses Z2M_AUTH_TOKEN for frontend auth.
Z2M2_TRANSPORT=usb
Z2M2_TCP_HOST=
Z2M2_TCP_PORT=6638
Z2M2_BAUDRATE=
Z2M2_ADAPTER=ember
Z2M2_CHANNEL=15
Z2M2_FRONTEND_PORT=8100
Z2M2_BASE_TOPIC=zigbee2mqtt2

# Optional: enable services beyond the base HA + Mosquitto stack.
# Comma-separated profiles. Available: z2m, z2m2, matter, matter-hub
# z2m is also auto-enabled if a zigbee coordinator is detected by setup.sh.
# Examples:
#   COMPOSE_PROFILES=matter,matter-hub
#   COMPOSE_PROFILES=matter-hub
#   COMPOSE_PROFILES=
COMPOSE_PROFILES=z2m,matter,matter-hub

# --- Auto-populated by scripts/setup.sh on first run. Do not edit by hand. ---
MOSQUITTO_PASSWORD=
Z2MPATH=
Z2M_AUTH_TOKEN=
Z2M_DEVICE_MAP=
Z2M_SERIAL_PORT=
Z2M2_PATH=
Z2M2_DEVICE_MAP=
Z2M2_SERIAL_PORT=
HA_ADMIN_PASSWORD=
HAMH_HTTP_AUTH_PASSWORD=
HAMH_HOME_ASSISTANT_ACCESS_TOKEN=